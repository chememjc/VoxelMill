#!/bin/sh
# Relocatable entry: bundled CPython + site-packages, never the host venv.
set -e
HERE=$(dirname "$(readlink -f "$0")")
export PYTHONHOME="$HERE/usr"
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE/usr/lib/python3.10/site-packages"
LIB="$HERE/usr/lib"
export LD_LIBRARY_PATH="$LIB:$LIB/python3.10/lib-dynload:$LIB/python3.10/site-packages/vtkmodules:$LIB/python3.10/site-packages/PySide6${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -d "$HERE/usr/lib/python3.10/site-packages/PySide6/Qt/plugins" ]; then
  export QT_PLUGIN_PATH="$HERE/usr/lib/python3.10/site-packages/PySide6/Qt/plugins"
  export QT_QPA_PLATFORM_PLUGIN_PATH="$HERE/usr/lib/python3.10/site-packages/PySide6/Qt/plugins/platforms"
fi
# Double-click (no args) or a single existing file opens the editor when it is
# bundled. CLI-only images still fall through to argparse help.
if [ -d "$HERE/usr/lib/python3.10/site-packages/PySide6" ]; then
  if [ $# -eq 0 ]; then
    set -- gui
  elif [ $# -eq 1 ] && [ -e "$1" ]; then
    case "$1" in
      -*) ;;
      *) set -- gui "$1" ;;
    esac
  fi
fi
exec "$HERE/usr/bin/python3.10" -c "import sys; from voxelmill.cli import main; sys.exit(main())" "$@"
