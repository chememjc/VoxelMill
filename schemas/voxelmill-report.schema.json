{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://voxelmill.local/schemas/voxelmill-report.schema.json",
  "title": "voxelmill report",
  "description": "Common JSON report envelope written by voxelmill commands.",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Report envelope version; currently 1."
    },
    "settings": {
      "type": "object",
      "description": "Resolved settings used for the run, when recorded."
    },
    "diagnostics": {
      "type": "array",
      "description": "Top-level diagnostics for prepare-style reports.",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info", "debug"]
          },
          "layer": { "type": ["integer", "null"] },
          "position_mm": {
            "type": ["array", "null"],
            "items": { "type": "number" }
          },
          "details": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
